NAME   = gens4all
RM     = rm -f
CC     = gcc-3.4
CXX    = g++-3.4
STRIP  = strip

PROG   = $(NAME)
CPPFLAGS  = $(CFLAGS)

include config.mk

DEFAULT_CFLAGS = `sdl-config --cflags`
LDFLAGS        = `sdl-config --libs` -lSDL_mixer -lz

NASM= nasm
NASM_FLAGS= -O1 -D __GCC2 -f elf -Isrc/ -Isrc/mem/ -Isrc/cpu/sh2/ -Isrc/cpu/z80/x86/

MORE_CFLAGS = -O2 -DDATA_PREFIX=\"./data/\" -DROM_PREFIX=\"./example\"
MORE_CFLAGS += -DINLINE="static __inline__"

ifdef NO_SOUND
MORE_CFLAGS += -DNO_SOUND
endif

#MORE_CFLAGS += -DDEBUG_GENS4ALL
##MORE_CFLAGS += -DDEBUG_GENS4ALL_FFLUSH
##MORE_CFLAGS += -DDEBUG_M68K
##MORE_CFLAGS += -DDEBUG_M68K_MEM
#MORE_CFLAGS += -DDEBUG_VDP
#NASM_FLAGS += -DDEBUG_VDP
#MORE_CFLAGS += -DSTART_DEBUG=194
#MORE_CFLAGS += -DEND_DEBUG=195

#MORE_CFLAGS += -DPROFILER_GENS4ALL
#MORE_CFLAGS += -DRESET_PROFILER=1500
#MORE_CFLAGS += -DEND_PROFILER=2500

ifndef TARGET_SYS
TARGET_SYS=x86
endif

ifdef FAMEC
MORE_CFLAGS += -DFAMEC
endif

MORE_CFLAGS += -DTARGET_SYS=$(TARGET_SYS)
CFLAGS  = $(DEFAULT_CFLAGS) $(MORE_CFLAGS) -Isrc -Isrc/cd -Isrc/cpu -Isrc/cpu/m68k -Isrc/cpu/sh2 -Isrc/cpu/z80 -Isrc/mem -Isrc/sound -Isrc/util -Isrc/video -Isrc/vdp
CPPFLAGS  = $(CFLAGS)


all: $(PROG)

dist: $(PROG)
	$(STRIP) $(PROG)

ifdef FAMEC
src/cpu/m68k/fame/fame.c:
	make -C src/cpu/m68k/fame/ format=omf target=indepent

src/cpu/m68k/fame/fame.o: src/cpu/m68k/fame/fame.c
else
src/cpu/m68k/fame/fame.asm: 
	make -C src/cpu/m68k/fame/ target=$(TARGET_SYS) gens

src/cpu/m68k/fame/fame.o: src/cpu/m68k/fame/fame.asm
	$(NASM) -f elf src/cpu/m68k/fame/fame.asm
endif

# Using RAZE x86 for any target
src/cpu/z80/raze/x86/raze1.asm: src/cpu/z80/raze/x86/raze.asm
	$(NASM) -Isrc/cpu/z80/raze/x86/ -e src/cpu/z80/raze/x86/raze.asm -o src/cpu/z80/raze/x86/raze1.asm

src/cpu/z80/raze/x86/raze.o: src/cpu/z80/raze/x86/raze1.asm
	$(NASM) $(NASM_FLAGS) src/cpu/z80/raze/x86/raze1.asm -o src/cpu/z80/raze/x86/raze.o -psrc/cpu/z80/raze/x86/raze.reg

src/mem/mem_s68k.o: src/mem/mem_s68k.asm
	$(NASM) $(NASM_FLAGS) $<

src/mem/mem_sh2.o: src/mem/mem_sh2.asm
	$(NASM) $(NASM_FLAGS) $<

ifeq ($(TARGET_SYS),x86)

ifdef VIDEO_ASSEMBLER
src/video/blit.o: src/video/blit.asm
	$(NASM) $(NASM_FLAGS) $<

src/video/hq2x16.o: src/video/hq2x16.asm
	$(NASM) $(NASM_FLAGS) $<

src/vdp/vdp_rend.o: src/vdp/vdp_rend.asm
	$(NASM) $(NASM_FLAGS) $<

src/cpu/z80/stef/z80.o: src/cpu/z80/stef/z80.asm
	$(NASM) $(NASM_FLAGS) $<

src/vdp/vdp_32x.o: src/vdp/vdp_32x.asm
	$(NASM) $(NASM_FLAGS) $<
endif

src/sound/%.o: src/sound/%.asm
	$(NASM) $(NASM_FLAGS) $<

ifndef FAME
src/cpu/m68k/starscream/main68k.o: src/cpu/m68k/starscream/main68k.asm
	$(NASM) $(NASM_FLAGS) $<

src/cpu/m68k/starscream/sub68k.o: src/cpu/m68k/starscream/sub68k.asm
	$(NASM) $(NASM_FLAGS) $<
endif

ifdef SEGA_CD
src/video/gfx_cd.o: src/video/gfx_cd.asm
	$(NASM) $(NASM_FLAGS) $<
endif

#%.o: %.asm
#	$(NASM) $(NASM_FLAGS) $<

endif


# Main object files
OBJS =  src/main.o \
	src/gens.o \
	src/genesis.o \
	src/port.o \
	src/ui.o \
	src/io.o \
	src/input.o \
	src/misc.o \
	src/mem/mem_m68k.o \
	src/cpu/m68k/cpu_m68k.o \
	src/cpu/z80/cpu_z80.o \
	src/mem/mem_z80.o \
	src/util/rom.o \
	src/util/ggenie.o \
	src/util/gym.o \
	src/util/save.o \
	src/util/scrshot.o \
	src/util/wave.o \
	src/video/draw.o \
	src/video/blit.o \
	src/util/SFont.o \
	src/vdp/vdp_io.o \
	src/vdp/vdp_rend.o \
	src/sound/pcm.o \
	src/sound/psg.o \
	src/sound/ym2612.o \
	src/sound/sound.o \
	src/util/unzip.o \
		src/menu/menu.o \
		src/menu/filemenu.o \
	src/vdp/vdp_spy.o


#	src/video/hqfilters.o \

# Sega CD object files
ifdef SEGA_CD
	OBJS += src/segacd.o \
		src/cpu/m68k/starscream/sub68k.o \
		src/mem/mem_s68k.o \
		src/video/gfx_cd.o \
		src/cd/cd_aspi.o \
		src/cd/cd_file.o \
		src/cd/cd_sys.o \
		src/cd/lc89510.o
endif

# Sega 32X object files
ifdef SEGA_32X
	OBJS += src/sega32x.o \
		src/cpu/sh2/cpu_sh2.o \
		src/cpu/sh2/sh2.o \
		src/cpu/sh2/sh2a.o \
		src/mem/mem_sh2.o \
		src/vdp/vdp_32x.o \
		src/sound/pwm.o 
endif

# FAME 68000 emulator
ifdef FAME
	CFLAGS+= -DFAME
	OBJS += src/cpu/m68k/fame/fame.o
else
	OBJS += src/cpu/m68k/starscream/main68k.o
endif

# RAZE Z80 emulator
ifdef RAZE
	CFLAGS+= -DRAZE -Isrc/cpu/z80/raze
	OBJS += src/cpu/z80/raze/x86/raze.o
else
	OBJS += src/cpu/z80/stef/z80.o
endif


$(PROG): $(OBJS) 
	$(CC) $(CFLAGS) -o $(PROG) $(OBJS) $(LDFLAGS)
	$(STRIP) $(PROG)

run: $(PROG) 
	./$(PROG) example/example.bin.gz

clean:
	$(RM) $(PROG) $(OBJS) src/cpu/z80/raze/x86/raze1.asm src/cpu/m68k/fame/fame.asm
ifdef FAME
ifdef FAMEC
	make -C src/cpu/m68k/fame/ target=indepent clean
else
	make -C src/cpu/m68k/fame/ target=x86 clean
endif
endif
