# Fichero de configuracion makefile gens4all

# Target system (x86, sh4, ...)
#TARGET_SYS=x86

# Use assembler code for video (only for x86)
#VIDEO_ASSEMBLER = 1

# Enable Sega CD emulation
#SEGA_CD = 1

# Enable Sega 32X emulation
#SEGA_32X = 1

# Use FAME M68K emulator
FAME=1
#FAMEC=1

# Use RAZE Z80 emulator
RAZE=1

# Disable sound
#NO_SOUND = 1

