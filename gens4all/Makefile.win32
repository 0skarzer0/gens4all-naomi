NAME   = gens4all
RM     = rm -f
CC     = gcc
CXX    = g++
STRIP  = strip

PROG   = $(NAME).exe
CPPFLAGS  = $(CFLAGS)

include config.mk

DEFAULT_CFLAGS = `sdl-config --cflags`
LDFLAGS        = `sdl-config --libs` -lmingw32 -lmingwex -mwindows

NASM= nasm
NASM_FLAGS= -O1 -D __GCC2 -f gnuwin32 -Isrc/ -Isrc/mem/ -Isrc/cpu/sh2/ -Isrc/cpu/z80/x86/

MORE_CFLAGS = -O2 -DDATA_PREFIX=\"./data/\" -DROM_PREFIX=\"./example\"
MORE_CFLAGS += -DINLINE="static __inline__"

ifdef NO_SOUND
MORE_CFLAGS += -DNO_SOUND
endif

#MORE_CFLAGS += -DDEBUG_GENS4ALL
##MORE_CFLAGS += -DDEBUG_GENS4ALL_FFLUSH
##MORE_CFLAGS += -DDEBUG_M68K
##MORE_CFLAGS += -DDEBUG_M68K_MEM
##MORE_CFLAGS += -DDEBUG_VDP
##NASM_FLAGS += -DDEBUG_VDP
#MORE_CFLAGS += -DSTART_DEBUG=1257
#MORE_CFLAGS += -DEND_DEBUG=1258

#MORE_CFLAGS += -DPROFILER_GENS4ALL
#MORE_CFLAGS += -DRESET_PROFILER=1500
#MORE_CFLAGS += -DEND_PROFILER=2500

ifndef TARGET_SYS
TARGET_SYS=x86
endif

MORE_CFLAGS += -DTARGET_SYS=$(TARGET_SYS)
CFLAGS  = $(DEFAULT_CFLAGS) $(MORE_CFLAGS) -Isrc -Isrc/cd -Isrc/cpu -Isrc/cpu/m68k -Isrc/cpu/sh2 -Isrc/cpu/z80 -Isrc/mem -Isrc/sound -Isrc/util -Isrc/video -Isrc/vdp
CPPFLAGS  = $(CFLAGS)


all: $(PROG)

dist: $(PROG)
	$(STRIP) $(PROG)

ifdef FAMEC
src/cpu/m68k/fame/fame.c:
	make -C src/cpu/m68k/fame/ format=omf target=indepent

src/cpu/m68k/fame/fame.o: src/cpu/m68k/fame/fame.c
else
src/cpu/m68k/fame/fame.asm: 
	make -C src/cpu/m68k/fame/ format=omf target=$(TARGET_SYS) gens

src/cpu/m68k/fame/fame.o: src/cpu/m68k/fame/fame.asm
	$(NASM) -f gnuwin32 src/cpu/m68k/fame/fame.asm
endif

# Using RAZE x86 for any target
src/cpu/z80/raze/x86/raze1.asm: src/cpu/z80/raze/x86/raze.asm
	$(NASM) -Isrc/cpu/z80/raze/x86/ -e src/cpu/z80/raze/x86/raze.asm -o src/cpu/z80/raze/x86/raze1.asm

src/cpu/z80/raze/x86/raze2.asm: src/cpu/z80/raze/x86/raze1.asm
	sed -e "s/z80_add_read/_z80_add_read/g" -e "s/z80_add_write/_z80_add_write/g" -e "s/z80_emulate/_z80_emulate/g" -e "s/z80_end_memmap/_z80_end_memmap/g" -e "s/z80_get_reg/_z80_get_reg/g" -e "s/z80_init_memmap/_z80_init_memmap/g" -e "s/z80_lower_IRQ/_z80_lower_IRQ/g" -e "s/z80_map_fetch/_z80_map_fetch/g" -e "s/z80_raise_IRQ/_z80_raise_IRQ/g" -e "s/z80_reset/_z80_reset/g"  src/cpu/z80/raze/x86/raze1.asm > src/cpu/z80/raze/x86/raze2.asm

src/cpu/z80/raze/x86/raze.o: src/cpu/z80/raze/x86/raze2.asm
	$(NASM) $(NASM_FLAGS) src/cpu/z80/raze/x86/raze2.asm -o src/cpu/z80/raze/x86/raze.o -psrc/cpu/z80/raze/x86/raze.reg

src/mem/mem_s68k.o: src/mem/mem_s68k.asm
	$(NASM) $(NASM_FLAGS) $<

src/mem/mem_sh2.o: src/mem/mem_sh2.asm
	$(NASM) $(NASM_FLAGS) $<

ifeq ($(TARGET_SYS),x86)

ifdef VIDEO_ASSEMBLER
src/video/blit.o: src/video/blit.asm
	$(NASM) $(NASM_FLAGS) $<

src/video/hq2x16.o: src/video/hq2x16.asm
	$(NASM) $(NASM_FLAGS) $<

src/vdp/vdp_rend.o: src/vdp/vdp_rend_1.asm
	$(NASM) $(NASM_FLAGS) -o src/vdp/vdp_rend.o src/vdp/vdp_rend_1.asm

src/vdp/vdp_rend_1.asm: src/vdp/vdp_rend.asm
	sed -e "s/print_/_print_/g" -e "s/CRam/_CRam/g" -e "s/H_Cell/_H_Cell/g" -e "s/H_Pix/_H_Pix/g" -e "s/H_Scroll_/_H_Scroll_/g" -e "s/H_Win_Mul/_H_Win_Mul/g" -e "s/ScrA_Addr/_ScrA_Addr/g" -e "s/ScrB_Addr/_ScrB_Addr/g" -e "s/Spr_Addr/_Spr_Addr/g" -e "s/VDP_Current_Line/_VDP_Current_Line/g" -e "s/VDP_Reg/_VDP_Reg/g" -e "s/VDP_Status/_VDP_Status/g" -e "s/VRam/_VRam/g" -e "s/VSRam/_VSRam/g" -e "s/V_Scroll_/_V_Scroll_/g" -e "s/Win_Addr/_Win_Addr/g" -e "s/Win_X_Pos/_Win_X_Pos/g" -e "s/Win_Y_Pos/_Win_Y_Pos/g" src/vdp/vdp_rend.asm > src/vdp/vdp_rend_1.asm

endif

src/cpu/z80/stef/z80_1.o: src/cpu/z80/stef/z80_1.asm
	$(NASM) $(NASM_FLAGS) $<

src/cpu/z80/stef/z80_1.asm: src/cpu/z80/stef/z80.asm
	sed -e "s/Ram_Z80/_Ram_Z80/g" src/cpu/z80/stef/z80.asm > src/cpu/z80/stef/z80_1.asm

src/sound/%.o: src/sound/%.asm
	$(NASM) $(NASM_FLAGS) $<

src/vdp/vdp_32x.o: src/vdp/vdp_32x.asm
	$(NASM) $(NASM_FLAGS) $<

ifndef FAME
src/cpu/m68k/starscream/main68k_1.o: src/cpu/m68k/starscream/main68k_1.asm
	$(NASM) $(NASM_FLAGS) $<

src/cpu/m68k/starscream/main68k_1.asm: src/cpu/m68k/starscream/main68k.asm
	sed -e "s/Int_Ack/_Int_Ack/g" -e "s/M68K_RB/_M68K_RB/g" -e "s/M68K_RW/_M68K_RW/g" -e "s/M68K_WB/_M68K_WB/g" -e "s/M68K_WW/_M68K_WW/g" -e "s/Ram_68k/_Ram_68k/g" src/cpu/m68k/starscream/main68k.asm > src/cpu/m68k/starscream/main68k_1.asm


src/cpu/m68k/starscream/sub68k.o: src/cpu/m68k/starscream/sub68k.asm
	$(NASM) $(NASM_FLAGS) $<
endif

ifdef SEGA_CD
src/video/gfx_cd.o: src/video/gfx_cd.asm
	$(NASM) $(NASM_FLAGS) $<
endif

#%.o: %.asm
#	$(NASM) $(NASM_FLAGS) $<

endif


# Main object files
OBJS =  src/main.o \
	src/gens.o \
	src/genesis.o \
	src/port.o \
	src/io.o \
	src/input.o \
	src/misc.o \
	src/mem/mem_m68k.o \
	src/cpu/m68k/cpu_m68k.o \
	src/cpu/z80/cpu_z80.o \
	src/mem/mem_z80.o \
	src/util/rom.o \
	src/util/ggenie.o \
	src/util/gym.o \
	src/util/save.o \
	src/util/scrshot.o \
	src/util/wave.o \
	src/video/draw.o \
	src/video/blit.o \
	src/ui.o \
	src/util/SFont.o \
	src/vdp/vdp_io.o \
	src/vdp/vdp_rend.o \
	src/sound/pcm.o \
	src/sound/psg.o \
	src/sound/ym2612.o \
	src/sound/sound.o \
	src/util/unzip.o \
	src/vdp/vdp_spy.o


#	src/video/hqfilters.o \

# Sega CD object files
ifdef SEGA_CD
	OBJS += src/cpu/m68k/starscream/sub68k.o \
		src/mem/mem_s68k.o \
		src/video/gfx_cd.o \
		src/cd/cd_aspi.o \
		src/cd/cd_file.o \
		src/cd/cd_sys.o \
		src/cd/lc89510.o
endif

# Sega 32X object files
ifdef SEGA_32X
	OBJS += src/sega32x.o \
		src/cpu/sh2/cpu_sh2.o \
		src/cpu/sh2/sh2.o \
		src/cpu/sh2/sh2a.o \
		src/mem/mem_sh2.o \
		src/vdp/vdp_32x.o \
		src/sound/pwm.o
endif

# FAME 68000 emulator
ifdef FAME
	CFLAGS+= -DFAME
	OBJS += src/cpu/m68k/fame/fame.o
else
	OBJS += src/cpu/m68k/starscream/main68k_1.o
endif

# RAZE Z80 emulator
ifdef RAZE
	CFLAGS+= -DRAZE -Isrc/cpu/z80/raze
	OBJS += src/cpu/z80/raze/x86/raze.o
else
	OBJS += src/cpu/z80/stef/z80_1.o
endif


#
$(PROG): $(OBJS) 
	$(CC) -L/usr/local/lib -L. -o $(PROG) -lmingw32 $(OBJS) -lSDL_static_129 -lstdc++ -lpthread -mwindows -mno-cygwin -luser32 -lgdi32 -lwinmm -ldxguid
	$(STRIP) $(PROG)

run: $(PROG) 
	./$(PROG) example/example.bin.gz

clean:
	$(RM) $(PROG) $(OBJS) src/cpu/z80/raze/x86/raze1.asm src/cpu/m68k/fame/fame.asm  src/vdp/vdp_rend_1.asm src/cpu/m68k/starscream/main68k_1.asm src/cpu/z80/raze/x86/raze2.asm src/cpu/z80/stef/z80_1.asm src/cpu/m68k/fame/famex86.exe stdout.txt stderr.txt
ifdef FAME
ifdef FAMEC
	make -C src/cpu/m68k/fame/ target=indepent clean
else
	make -C src/cpu/m68k/fame/ target=x86 clean
endif
endif
