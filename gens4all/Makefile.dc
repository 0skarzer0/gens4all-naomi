TARGET = gens4all

KOS_CFLAGS+= -I$(KOS_BASE)/addons/include -I$(KOS_BASE)/addons/include/SDL -DDREAMCAST

KOS_CFLAGS+= -O2 -fomit-frame-pointer -ffast-math -ffp-contract=fast -mfsrra -mfsca -mpretend-cmove
#-frename-registers -ftracer -funit-at-a-time -funswitch-loops

KOS_CFLAGS+= -Isrc -Isrc/cd -Isrc/cpu -Isrc/cpu/m68k -Isrc/cpu/sh2 -Isrc/cpu/z80 -Isrc/mem -Isrc/sound -Isrc/util -Isrc/video -Isrc/vdp

KOS_CFLAGS+= -Wno-unused -Wno-format -DGCCCONSTFUNC="__attribute__((const))" -fno-exceptions -DINLINE=static__inline__

#KOS_CFLAGS += -DRESET_PROFILER=1500
#KOS_CFLAGS += -DEND_PROFILER=2500
KOS_CFLAGS += -DDEBUG_GENS4ALL -DDEBUG_GENS4ALL_FFLUSH


KOS_CFLAGS+= -DROM_PREFIX="/pc/gensrom" -DDATA_PREFIX="/rd/"

KOS_CFLAGS+= -DRAZE -DFAME

#~ KOS_CFLAGS+= -DPROFILER_GENS4ALL
KOS_CFLAGS+= -DDEBUGCOMMANDS=0
KOS_CFLAGS+= -DDEBUGDISPLAYDEFAULT=0
KOS_CFLAGS+= -DGAMELISTLOADER=1
KOS_CFLAGS+= -DSKIPTITLE=0
KOS_CFLAGS+= -DGAMELISTFNAME="/cd/gamelist.bin"
#~ KOS_CFLAGS+= -DGAMELISTFNAME="/pc/home/alex/dc/gens4all/src/glparse/gamelist.bin"
KOS_CFLAGS+= -DSKIPLOADER=0
KOS_CFLAGS+= -DINLINE68K=1
KOS_CFLAGS+= -DSORTDIR=0
KOS_CFLAGS+= -DSAVE_TO_PC=0
#~ KOS_CFLAGS+= -DVDP_HIRES
KOS_CFLAGS+= -DVDP_STRETCH_256=0

KOS_CPPFLAGS = $(KOS_CFLAGS)

all: $(TARGET).bin

include $(KOS_BASE)/Makefile.rules

include config.mk

CFLAGS+= -Isrc/incplus

%.o: %.S
	kos-cc -c $< -o $@

#ifdef NO_SOUND
#KOS_CFLAGS += -DNO_SOUND
#endif


src/cpu/m68k/fame/fame.s:
	make -C src/cpu/m68k/fame/ target=sh4 gens

src/cpu/m68k/fame/fame.o: src/cpu/m68k/fame/fame.s

src/cpu/z80/raze/sh4/raze1.s: src/cpu/z80/raze/sh4/raze.s.m4
	m4 -Isrc/cpu/z80/raze/sh4/ src/cpu/z80/raze/sh4/raze.s.m4 > src/cpu/z80/raze/sh4/raze1.s

src/cpu/z80/raze/sh4/raze1.o: src/cpu/z80/raze/sh4/raze1.s
src/pvrvdp/nrender.o: src/pvrvdp/nrender.c src/pvrvdp/ntilemap.c src/pvrvdp/nsprite.c

OBJS =	\
	src/main.o \
		src/loader.o \
		src/gamemenu.o \
		src/bmf.o \
		src/fastmem.o \
		src/sounddc/snd_stream.o \
	src/gens.o \
	src/genesis.o \
	src/port.o \
	src/ui.o \
	src/io.o \
	src/input.o \
	src/misc.o \
	src/mem/mem_m68k.o \
	src/cpu/m68k/cpu_m68k.o \
	src/cpu/z80/cpu_z80.o \
	src/mem/mem_z80.o \
	src/util/rom.o \
	src/util/ggenie.o \
	src/util/gym.o \
	src/util/save.o \
	src/util/scrshot.o \
	src/util/wave.o \
	src/video/draw.o \
	src/video/blit.o \
	src/util/SFont.o \
	src/vdp/vdp_io.o \
	src/vdp/vdp_rend.o \
	src/sound/psg.o \
	src/sound/ym2612.o \
		src/sound/ym2612_asm.o \
	src/sound/sound.o \
	src/util/unzip.o \
	src/vdp/vdp_spy.o \
	src/cpu/m68k/fame/fame.o \
	src/cpu/z80/raze/sh4/raze1.o \
		src/menu/menu.o \
		src/menu/filemenu.o \
		src/pvrvdp/draw.o \
		src/pvrvdp/drawtilepvr.o \
		src/pvrvdp/drawrow.o \
		src/pvrvdp/drawrow_noclip.o \
		src/pvrvdp/init.o \
		src/pvrvdp/render.o \
		src/pvrvdp/nrender.o \
		src/pvrvdp/vram2tex.o \
		src/pvrvdp/vram2tex_ilace.o \
		src/pvrvdp/bgplane.o \
		src/pvrvdp/pal2cb.o \
		src/pvrvdp/pal2cb_shadow.o \
		src/pvrvdp/profile.o \
		src/pvrvdp/watchdog.o \
	romdisk.o
	
#~ 	src/sound/pcm.o \

clean:
	rm -f $(OBJS) $(TARGET).elf $(TARGET).bin  romdisk.o romdisk.img example.iso src/cpu/m68k/fame/famesh4.exe src/cpu/m68k/fame/famesh4 src/cpu/z80/raze/sh4/raze1.s
	make -C src/cpu/m68k/fame/ target=sh4 clean

$(TARGET).elf: $(OBJS)
	$(KOS_CC) $(KOS_CFLAGS) $(KOS_LDFLAGS) -o $(TARGET).elf $(KOS_START) \
	$(OBJS) $(OBJEXTRA) -lSDLDH -lz -lm $(KOS_LIBS)


$(TARGET).bin: $(TARGET).elf
	$(KOS_OBJCOPY) -R .stack -O binary $(TARGET).elf $(TARGET).bin

romdisk.o: romdisk.img
	$(KOS_BASE)/utils/bin2o/bin2o romdisk.img romdisk romdisk.o

romdisk.img:
	$(KOS_GENROMFS) -f romdisk.img -d data -v

example.iso: example
	mkisofs -joliet-long -l -o example.iso -graft-points /=example/


run: $(TARGET).bin example.iso
	$(KOS_LOADER) $(TARGET).bin -i example.iso
#	$(KOS_LOADER) $(TARGET).bin 
#	$(KOS_LOADER) $(TARGET).bin -n


